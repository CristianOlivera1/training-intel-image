    "import tensorflow as tf\n",
    "\n",
    "gpu_devices = tf.config.list_physical_devices('GPU')\n",
    "\n",
    "if gpu_devices:\n",
    "    print(f\"Success! Detected {len(gpu_devices)} GPU(s).\")\n",
    "    for gpu in gpu_devices:\n",
    "        print(\"Details:\", gpu)\n",
    "else:\n",
    "    print(\"GPU still not detected.\")\n"
   ]
